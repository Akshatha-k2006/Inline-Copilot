# ---- Backend (backend/.env) ----
DATABASE_URL=sqlite:///./inline_copilot.db
CORS_ORIGINS=http://localhost:3000

# Hosted LLM. Leave LLM_API_KEY empty to run rule-based checks only.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15

# ---- Frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
